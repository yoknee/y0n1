{
  "brand": "Baton",
  "purpose": "Stand-in brand for the audit platform reconstruction. Not the production product.",
  "rules": [
    "Color never carries state alone. Every state has a glyph and a text label.",
    "--bt-agent is reserved for content the agent produced. Human-authored content never uses it.",
    "No oranges, no reds outside --bt-failed, no gradients, no brand photography.",
    "Focus ring on every focusable element in both themes."
  ],
  "color": {
    "light": {
      "surface": "#FFFFFF", "surface-2": "#F3F5F8", "surface-3": "#E8EBF0", "border": "#CFD5DD",
      "ink": "#14181F", "ink-2": "#4A5361", "ink-3": "#687180",
      "brand": "#3B4FD8", "agent": "#0E7C7B", "review": "#8E5F00", "approved": "#1F7A3D", "edited": "#6941C6", "failed": "#B42318",
      "brand-tint": "#E8EBFB", "agent-tint": "#DDF3F2", "review-tint": "#FBF0D6", "approved-tint": "#DFF3E5", "edited-tint": "#EEE8FB", "failed-tint": "#FBE3E0"
    },
    "dark": {
      "surface": "#0F1319", "surface-2": "#171C24", "surface-3": "#1F2630", "border": "#2C343F",
      "ink": "#E6EAF0", "ink-2": "#A5AEBB", "ink-3": "#7E8794",
      "brand": "#8FA0FF", "agent": "#5FD3CF", "review": "#E8B84A", "approved": "#6CCB8A", "edited": "#B69CFF", "failed": "#FF8A80",
      "brand-tint": "#1C2347", "agent-tint": "#103A3A", "review-tint": "#3D2E0A", "approved-tint": "#0F3320", "edited-tint": "#2A1F4D", "failed-tint": "#4A1612"
    }
  },
  "type": {
    "sans": "Plex Sans", "mono": "Plex Mono",
    "scale": [11, 12, 13, 14, 16, 20, 28],
    "lineHeight": { "grid": 1.35, "prose": 1.5 },
    "numerals": "tabular wherever a column aligns"
  },
  "space": { "base": 4, "rowDense": 28, "rowForm": 36, "gutter": 12, "radius": 3 },
  "motion": { "state": "120ms", "layout": "none", "reducedMotion": "all motion removed" },
  "icon": { "size": 16, "stroke": 1.5, "style": "single color, in-house SVG set, no emoji" }
}
